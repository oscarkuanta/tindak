{
  "name": "tindak",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "T!indak: board pengaduan masalah fisik berbasis komunitas",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "npm run test -w server && npm run test -w client",
    "db:generate": "npm run db:generate -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:deploy": "npm run db:deploy -w server",
    "db:seed": "npm run db:seed -w server",
    "db:seed:demo": "npm run db:seed:demo -w server --",
    "smoke": "npm run smoke -w server --",
    "db:studio": "npm run db:studio -w server",
    "db:reset": "npm run db:reset -w server",
    "make-admin": "npm run make-admin -w server --",
    "make-board-admin": "npm run make-board-admin -w server --",
    "postinstall": "npm run db:generate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  }
}
